# ==========================================================================
# Biến môi trường SunPrime Landing Page (copy thành .env.local để dev/.env trên VPS)
# ==========================================================================

# --- News API ---
# Base URL backend cung cấp tin tức. Mặc định trong code đã là production:
#   https://api.sunprime.vn
# Chỉ cần set biến này khi muốn trỏ sang backend khác (vd dev local).
# SUNPRIME_API_BASE_URL=https://api.sunprime.vn
# Dev local (nếu chạy backend ở máy):
# SUNPRIME_API_BASE_URL=http://localhost:2412

# Token xác thực API news — TUỲ CHỌN. Endpoint production là public, KHÔNG cần token.
# Chỉ set khi backend của bạn yêu cầu Bearer token.
# SUNPRIME_NEWS_API_TOKEN=

# (Tuỳ chọn) Ghi đè trực tiếp từng endpoint, nếu khác cấu trúc mặc định:
# SUNPRIME_NEWS_API_URL=https://api.sunprime.vn/api/news/landing
# SUNPRIME_TOP_NEWS_API_URL=https://api.sunprime.vn/api/news/landing/top-news

# --- SEO / liên kết ---
# Domain công khai của landing (dùng cho canonical, sitemap, OG image).
# NEXT_PUBLIC_SITE_URL=https://sunprime.vn

# URL cổng B2B / đăng nhập (nút "Cổng B2B" + login).
# NEXT_PUBLIC_PORTAL_URL=https://portal.sunprime.vn

# --- Nội dung mẫu ---
# Khách hàng/đối tác, đội ngũ, đánh giá và số liệu hoạt động hiện là DỮ LIỆU MẪU nên mặc định bị ẨN.
# Chỉ đặt "true" sau khi đã thay bằng nội dung thật (xem lib/feature-flags.ts).
# NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=false

# Xem trước khối "Chứng nhận & giải thưởng" ở footer, gồm cả mục DỰ KIẾN (chưa đạt, có nhãn "Dự kiến").
# Chỉ đặt "true" trong .env.local trên máy xem trước, KHÔNG đặt trên production.
# Mục đã có thật (status "held" trong data/certifications.ts) hiện công khai bất kể cờ này.
# NEXT_PUBLIC_SHOW_CERT_PREVIEW=false

# --- Trợ lý chat AI (nút nổi "Nhận tư vấn ngay") ---
# Khoá API Claude: CHỈ đặt ở server (không có tiền tố NEXT_PUBLIC_), KHÔNG commit giá trị thật.
# Tạo khoá trong Anthropic Console. Thiếu khoá thì trợ lý báo "tạm thời chưa trả lời được" kèm nút nhắn Zalo,
# phần còn lại của website vẫn chạy bình thường.
# ANTHROPIC_API_KEY=
# (Tuỳ chọn) Đổi model. Mặc định claude-haiku-5-5 (model rẻ nhất hiện hành theo tài liệu Anthropic); muốn câu trả lời
# tốt hơn thì đổi sang claude-sonnet-5-5 (đắt hơn khoảng 20 lần).
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
NEXT_PUBLIC_CHAT_ENABLED=false
